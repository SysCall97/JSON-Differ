{
  "manifest_version": 3,
  "name": "RTDB Tree Editor",
  "version": "1.7.1",
  "description": "Edit Firebase Realtime Database data as a tree right in the console: add, duplicate, reorder, live sync, publish and roll back.",
  "homepage_url": "https://syscall97.github.io/JSON-Differ/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle the RTDB Tree editor (on a Firebase console tab)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.firebase.google.com/*"
      ],
      "js": [
        "session-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://console.firebase.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*",
    "https://console.firebase.google.com/*"
  ],
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {
      "resources": [
        "panel.js",
        "panel.css",
        "tree-editor.js",
        "icons/icon48.png"
      ],
      "matches": [
        "https://console.firebase.google.com/*"
      ]
    }
  ]
}
